PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PROVIDER_TIMEOUT_MS=6000
# eBay Browse API (free developer account: https://developer.ebay.com). Leave blank to disable.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US
# Set true to include clearly-labelled SAMPLE data (never live prices)
ENABLE_DEMO=false
# --- Database & auth ---
MONGODB_URI=mongodb://127.0.0.1:27017/smartcompare
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# --- Alerts: background refresh (0 = disabled). Only enabled providers are queried, max products per run. ---
REFRESH_INTERVAL_MINUTES=0
REFRESH_MAX_PRODUCTS=20
# --- Optional email for alerts; leave blank for in-app notifications only ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
