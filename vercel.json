{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client"
    },
    "server": {
      "root": "server"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/server/:match*"
    },
    {
      "source": "/:match*",
      "destination": "/client/:match*"
    }
  ]
}
